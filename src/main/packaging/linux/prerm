#!/bin/bash
# Pre-remove script Debian — executed before package uninstall.
# Stop + disable the service. We keep the `instantiot` user and its
# data in /var/lib/instantiot/ — the admin can wipe them
# manually for a full cleanup.

set -e

systemctl stop instantiot-server.service >/dev/null 2>&1 || true
systemctl disable instantiot-server.service >/dev/null 2>&1 || true
rm -f /etc/systemd/system/instantiot-server.service
systemctl daemon-reload

exit 0
