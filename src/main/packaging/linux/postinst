#!/bin/bash
# Post-install script Debian (.deb) — InstantIoT Server
# Executed by dpkg after package extraction.
#
# Steps:
#   1. Create the `instantiot` system user (no shell, no login)
#   2. Create /var/lib/instantiot/ (home + persistent state)
#   3. Install the systemd service
#   4. Enable + start at boot

set -e

# 1. Dedicated system user — id < 1000, no shell, no interactive home
if ! id -u instantiot >/dev/null 2>&1; then
    useradd --system \
            --no-create-home \
            --home-dir /var/lib/instantiot \
            --shell /usr/sbin/nologin \
            --comment "InstantIoT Server" \
            instantiot
fi

# 2. Home / data directory
install -d -o instantiot -g instantiot -m 0750 /var/lib/instantiot

# 3. Systemd service — contents inlined at build-time by the Gradle
#    packageInstaller task (the marker below is substituted with the
#    actual contents of src/main/packaging/linux/instantiot-server.service).
#    This avoids having to bundle a separate file in the .deb that
#    jpackage --resource-dir cannot embed.
cat > /etc/systemd/system/instantiot-server.service <<'__INSTANTIOT_SERVICE_EOF__'
@@SERVICE_INLINE_MARKER@@
__INSTANTIOT_SERVICE_EOF__

chown root:root /etc/systemd/system/instantiot-server.service
chmod 0644      /etc/systemd/system/instantiot-server.service

systemctl daemon-reload

# 4. Enable at boot + start now
systemctl enable instantiot-server.service >/dev/null 2>&1 || true
systemctl start instantiot-server.service >/dev/null 2>&1 || true

echo ""
echo "═══════════════════════════════════════════════════════════"
echo "  InstantIoT Server installed"
echo "═══════════════════════════════════════════════════════════"
echo ""
echo "  Status :   systemctl status instantiot-server"
echo "  Logs   :   journalctl -u instantiot-server -f"
echo "  Stop   :   sudo systemctl stop instantiot-server"
echo "  Start  :   sudo systemctl start instantiot-server"
echo ""
echo "  Web admin panel : http://$(hostname -I | awk '{print $1}'):8080"
echo "  (or any port the server falls back to if 8080 is busy)"
echo ""
echo "═══════════════════════════════════════════════════════════"

exit 0
