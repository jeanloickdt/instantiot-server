[Unit]
Description=InstantIoT Server — Self-hosted IoT dashboard backend
Documentation=https://docs.instantiot.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# User/Group dédiés — créés par le post-install script du .deb.
# Évite que le serveur tourne en root et limite l'impact d'une compromission.
User=instantiot
Group=instantiot

# Working directory + home : où le serveur stocke ses fichiers d'état.
# ~/.instantiot devient /var/lib/instantiot/.instantiot (cf. HOME ci-dessous)
Environment="HOME=/var/lib/instantiot"
WorkingDirectory=/var/lib/instantiot

# Un serveur géré par systemd est TOUJOURS headless (Pi OS Lite, Ubuntu
# Server, VPS — aucun X11). On force java.awt.headless=true : SystemTray
# .isSupported() / Desktop renvoient false de façon déterministe, AWT ne
# tente jamais de connexion X11 → zéro AWTError possible. Le JVM applique
# JAVA_TOOL_OPTIONS automatiquement. Scopé au service Linux : les installs
# desktop .dmg/.msi gardent leur system tray (vrai display).
Environment="JAVA_TOOL_OPTIONS=-Djava.awt.headless=true"

# Lance le binaire jpackage. Le path /opt/instantiot-server est défini
# par jpackage (--linux-package-name instantiot-server → /opt/<name>/).
ExecStart=/opt/instantiot-server/bin/InstantIoT\x20Server

# Redémarrage automatique en cas de crash. 5s entre les tentatives.
# Évite la storm si le serveur boucle sur une erreur fatale.
Restart=on-failure
RestartSec=5s

# Limites resource — généreux mais bornés pour ne pas faire couler un Pi.
# 512 MB RAM = largement assez (typique : ~150-200 MB)
MemoryMax=512M

# Logging vers journald — accessible via `journalctl -u instantiot-server`
StandardOutput=journal
StandardError=journal

# Hardening basique
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/instantiot

[Install]
WantedBy=multi-user.target
