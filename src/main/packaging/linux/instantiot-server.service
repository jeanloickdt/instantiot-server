[Unit]
Description=InstantIoT Server — Self-hosted IoT dashboard backend
Documentation=https://docs.instantiot.io
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Dedicated User/Group — created by the .deb post-install script.
# Prevents the server from running as root and limits the impact of a compromise.
User=instantiot
Group=instantiot

# Working directory + home: where the server stores its state files.
# ~/.instantiot becomes /var/lib/instantiot/.instantiot (see HOME below)
Environment="HOME=/var/lib/instantiot"
WorkingDirectory=/var/lib/instantiot

# A server managed by systemd is ALWAYS headless (Pi OS Lite, Ubuntu
# Server, VPS — no X11). We force java.awt.headless=true: SystemTray
# .isSupported() / Desktop return false deterministically, AWT never
# attempts an X11 connection → zero AWTError possible. The JVM applies
# JAVA_TOOL_OPTIONS automatically. Scoped to the Linux service: desktop
# .dmg/.msi installs keep their system tray (real display).
Environment="JAVA_TOOL_OPTIONS=-Djava.awt.headless=true"

# Launches the jpackage binary. The path /opt/instantiot-server is defined
# by jpackage (--linux-package-name instantiot-server → /opt/<name>/).
ExecStart=/opt/instantiot-server/bin/InstantIoT\x20Server

# Automatic restart on crash. 5s between attempts.
# Avoids the storm if the server loops on a fatal error.
Restart=on-failure
RestartSec=5s

# Resource limits — generous but bounded to avoid sinking a Pi.
# 512 MB RAM = plenty (typical: ~150-200 MB, heap capped at 256 MB by jpackage)
MemoryMax=512M

# One file descriptor per connected board, plus the app sessions and the
# database. The systemd default (1024) would stop the relay at roughly a
# thousand boards with "too many open files", far below the connection cap
# the relay enforces itself (RELAY_MAX_DEVICES, 10 000 by default).
LimitNOFILE=65536

# Logging to journald — accessible via `journalctl -u instantiot-server`
StandardOutput=journal
StandardError=journal

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/instantiot
# The same idea as the cloud's containers running with minimal rights: no
# kernel tunables, no device nodes, no new address families beyond what a
# TCP/UDP relay with mDNS needs, no setuid anywhere.
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
