meta {
  name: 3. Create Device
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/devices
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "name": "ESP32 Salon",
    "projectId": "{{projectId}}"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("deviceId", res.body.id);
    bru.setVar("deviceToken", res.body.token);
  }
}
