meta {
  name: 7. Get History — raw opaque (legacy)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/widgets/{{widgetId}}/history-raw?from={{fromMs}}&to={{toMs}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Ancienne route — retourne le payload Base64 brut de widget_history.

  Utile pour les widgets NON-numériques (boutons, switchs, segswitch,
  direction pad, joystick released) qui ne sont PAS dans la table
  numérique agrégée.

  - Rétention : 1 jour par défaut (history.retention.opaque.days).
  - Réponse : [{payload: "base64...", recordedAt: 1234}].
}

script:pre-request {
  if (!bru.getVar("fromMs") || bru.getVar("fromMs") === "") {
    bru.setVar("fromMs", (Date.now() - 3600000).toString());
  }
  if (!bru.getVar("toMs") || bru.getVar("toMs") === "") {
    bru.setVar("toMs", Date.now().toString());
  }
}
