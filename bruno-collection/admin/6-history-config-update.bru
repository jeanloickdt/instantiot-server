meta {
  name: Modifier les reglages d'historique
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/admin/history-config
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "rawEnabled": true,
    "retentionRawDays": 1,
    "retentionMinDays": 90
  }
}

docs {
  Applique a chaud : les boucles de fond relisent a chaque tour.
}
