#!/usr/bin/env bash
# Wrapper pour generate-licence.py qui auto-setup le venv si absent.
# Usage : ./licence [args...]   (depuis doc-and-test/)
#         ./doc-and-test/licence [args...]   (depuis la racine du repo)
#
# Equivalent à `python3 generate-licence.py [args...]` mais avec
# isolation venv (PEP 668 macOS friendly).

set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV="$SCRIPT_DIR/.venv"

# Setup venv si absent (premier lancement)
if [[ ! -d "$VENV" ]]; then
  echo "[licence] Setting up venv (first run)..."
  python3 -m venv "$VENV"
  "$VENV/bin/pip" install --quiet --upgrade pip
  "$VENV/bin/pip" install --quiet PyJWT cryptography
  echo "[licence] Venv ready."
fi

exec "$VENV/bin/python" "$SCRIPT_DIR/generate-licence.py" "$@"
