meta {
  name: 6. Get History — day buckets
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/widgets/{{widgetId}}/history?from={{fromMs}}&to={{toMs}}&granularity=day
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

docs {
  Buckets 1-jour agrégés de widget_history_day.

  - Rétention infinie par défaut (history.retention.day.days=-1).
  - Vide tant qu'une journée complète ne s'est pas écoulée.

  Fenêtre par défaut : dernière année.
}

script:pre-request {
  if (!bru.getVar("fromMs") || bru.getVar("fromMs") === "") {
    bru.setVar("fromMs", (Date.now() - 365 * 86400000).toString());
  }
  if (!bru.getVar("toMs") || bru.getVar("toMs") === "") {
    bru.setVar("toMs", Date.now().toString());
  }
}
